# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# IDE and editors
.idea/
.vscode/

# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Production builds
build/
dist/

# Testing
coverage/
test_reports/

# Caches
.cache/
*.pack

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Python
__pycache__/
*.py[cod]
venv/
.venv/

# Environment files and secrets
.env
.env.*
*.env
*.key
*.pem
credentials.json
*credentials.json*
*token.json*
.credentials
memory/test_credentials.md

# Emergent agent git identity — must never be committed
.gitconfig

# System files
.DS_Store
.aider*
